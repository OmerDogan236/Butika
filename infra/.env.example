# Production .env şablonu. Server'da /opt/butika/.env.production olarak yarat.
# Bu dosya git'te (örnek), gerçek .env.production .gitignore'da.
#
# Random secrets yaratma:
#   openssl rand -hex 32     # 64-char hex
#   openssl rand -base64 24  # 24-char base64

# ─── API ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Postgres (host'ta native, docker bridge üzerinden erişim)
DATABASE_URL=postgres://butika:CHANGE_ME@host.docker.internal:5432/butika

# JWT — 64-char hex önerilen (min 32 bytes)
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# /auth/dev production'da KOD TARAFINDAN kapalıdır; DEV_AUTH_ENABLED yok sayılır.
# Eski sunucu env'inde DEV_AUTH_ENABLED=true kaldıysa silin.

# JWT_SECRET / DATABASE_URL / MINIO_SECRET_KEY boş, CHANGE_ME veya dev
# varsayılanıysa API production'da açılmayı reddeder (deploy ön kontrolü de).

# ─── Fiyat takibi ve push bildirimleri (kontrollü açılış) ─────────────────────
# Production'da açıkça true yazılmadıkça ikisi de KAPALI.
# Hızlı durdurma: false yap →
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.production up -d api
# (yeni build gerekmez; /health yanıtındaki "workers" alanından doğrula)
PRICE_TRACKING_ENABLED=false
PUSH_DELIVERY_ENABLED=false
# Expo projesinde "Enhanced Security for Push" açıksa gerekli. Loglanmaz.
# EXPO_ACCESS_TOKEN=

# ─── Apple ile Giriş ─────────────────────────────────────────────────────────
# identityToken doğrulamasında "aud" bu olmalı — uygulamanın bundle id'si.
APPLE_BUNDLE_ID=app.butika

# ─── Google ile Giriş ────────────────────────────────────────────────────────
# idToken "aud" doğrulaması — Google Cloud Console OAuth Client ID'leri.
# En az WEB gerekli (mobil idToken'ın aud'u WEB client id olur).
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

CORS_ORIGINS=https://admin.butika.ai

# ─── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=butika
MINIO_ROOT_PASSWORD=CHANGE_ME_24_CHARS
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=https://cdn.butika.ai
MINIO_ACCESS_KEY=butika
MINIO_SECRET_KEY=CHANGE_ME_24_CHARS
MINIO_BUCKET=butika-uploads
MINIO_REGION=us-east-1

# ─── Admin ──────────────────────────────────────────────────────────────────
# Admin container API'ye internal hostname üzerinden bağlanır (compose ile zaten set,
# burada referans).
# API_URL=http://api:3000

ADMIN_SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
ADMIN_INITIAL_PASSWORD=CHANGE_ME_24_CHARS
ADMIN_INITIAL_EMAIL=admin@butika.ai

NEXTAUTH_URL=https://admin.butika.ai
NEXTAUTH_SECRET=CHANGE_ME_64_HEX_CHARS
