# Expo monorepo guide tavsiyesi: hoisted layout, çünkü React Native ekosistemi
# pnpm'in strict isolated layout'unu phantom dependency'ler nedeniyle bozar.
# https://docs.expo.dev/guides/monorepos/
node-linker=hoisted

# pnpm 10+ varsayılanı silent install scripts — bizim allowlist'imiz pnpm.onlyBuiltDependencies'de.
auto-install-peers=true
strict-peer-dependencies=false
