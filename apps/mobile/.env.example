# Expo otomatik yükler. EXPO_PUBLIC_ önekiyle başlayan değişkenler client'a açılır.
# Aşağıdaki değer set edilmezse src/lib/api.ts platform default'una düşer
# (iOS sim & web: http://localhost:3000, Android emu: http://10.0.2.2:3000).
#
# Fiziksel cihaz: bilgisayarın LAN IP'sini ver, örn:
# EXPO_PUBLIC_API_URL=http://<bilgisayarin-yerel-ip-adresi>:3000
EXPO_PUBLIC_API_URL=

# ─── Google ile Giriş ───────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# WEB client id: idToken'ın "aud"u bu olur; backend GOOGLE_CLIENT_ID_WEB ile aynı olmalı.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client id (Google, iOS uygulaması için ayrı bir client id verir).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# AYRICA: app.json'daki google-signin plugin "iosUrlScheme" değerini
# iOS client id'nin TERS hali ile değiştir: com.googleusercontent.apps.XXXX
