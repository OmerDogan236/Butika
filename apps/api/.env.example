NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://butika:butika@localhost:5432/butika

# JWT (production: openssl rand -base64 48)
JWT_SECRET=dev-secret-replace-in-prod-with-32-bytes-min
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081,http://localhost:19006

# Apple Sign In
APPLE_BUNDLE_ID=app.butika
# Google Sign In (Phase 1'de set edilecek)
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# /auth/dev doğrulamasız giriş (geliştirme ve test için, production'da yoksayılır)
# DEV_AUTH_ENABLED=true

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=butika
MINIO_SECRET_KEY=butika-dev-secret
MINIO_BUCKET=butika-uploads
MINIO_REGION=us-east-1

# Fiyat kontrol zamanlayıcısı ve push gönderimi. Boşsa geliştirmede açık,
# production'da kapalı. Yerelde gerçek mağazalara istek atmamak için false yapın.
# PRICE_TRACKING_ENABLED=false
# PUSH_DELIVERY_ENABLED=false
# Expo "Enhanced Security for Push" açıksa:
# EXPO_ACCESS_TOKEN=
